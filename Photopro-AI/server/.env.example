MONGODB_URI=mongodb://localhost:27017/photopro_ai
JWT_SECRET=your_jwt_secret_key_here
AI_API_KEY=your_ai_api_key_here
PAYMENT_API_KEY=your_payment_api_key_here
PAYMENT_SECRET=your_payment_secret_here
PORT=5000

# SendGrid email integration (server-side only — never expose to the frontend)
# API key with Mail Send permission + a Single Verified Sender address from SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_verified_sender_email@example.com
SENDGRID_FROM_NAME=PhotoPro AI
